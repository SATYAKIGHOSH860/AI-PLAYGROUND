# ---------------------------------------------------------------------------
# AI Playground configuration. Everything here is OPTIONAL.
# With no .env at all the app still runs: Python executes in the browser and
# C/C++ go to the keyless public Wandbox compiler service.
# ---------------------------------------------------------------------------

# Self-hosted Piston instance (https://github.com/engineer-man/piston).
# When set it becomes the FIRST provider tried for C/C++/Python-on-server.
# This is the recommended setup for production: no third-party rate limits.
#   docker run -d -p 2000:2000 --privileged ghcr.io/engineer-man/piston
#   PISTON_URL=http://localhost:2000/api/v2
# PISTON_URL=

# Order of execution providers to try, comma separated.
# Valid names: piston, wandbox, paiza
# Default: piston,wandbox,paiza  (piston is skipped unless PISTON_URL is set)
# EXECUTION_PROVIDERS=piston,wandbox,paiza

# Hard ceiling (ms) on a single server-side run before the API gives up.
# Keep below your host's function timeout. Default: 45000
# RUN_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Abuse protection for /api/run. Only C/C++ (and server-mode Python) are
# affected - browser Python never touches the server at all.
# ---------------------------------------------------------------------------

# Runs per minute, per client IP. Set to 0 to turn the window off.
# 15 is generous for a person: a student fixing errors presses Run 3-5 times
# a minute. It exists to stop a script hammering the shared public compilers
# until they block this deployment for everyone.
# RATE_LIMIT_PER_MINUTE=15

# Simultaneous in-flight runs, per client IP. Set to 0 to turn the cap off.
# This is the one that protects your hosting bill, because every run holds a
# serverless function open for a couple of seconds.
# RATE_LIMIT_CONCURRENT=2
